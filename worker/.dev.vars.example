# Copy this file to worker/.dev.vars for local development. NEVER commit .dev.vars or real keys.
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
SETUP_TOKEN=dev-setup-token
# enables the simulated payment gateway (ignored when ENVIRONMENT=production)
ALLOW_MOCK_PAYMENTS=true
# Pages carry the Google Analytics tag only on the real site. To see the tag on this machine, switch this on AND set an ID in Admin -> Settings -> Analytics
# (ignored when ENVIRONMENT=production). Leave it off unless you need it: with an ID of the real shop, your own browsing here would be counted as visits.
# ANALYTICS_DEV=true

# --- optional integrations: leave commented out to keep them switched off -------------
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# RESEND_API_KEY=
# GEMINI_API_KEY=
# TURNSTILE_SECRET=
