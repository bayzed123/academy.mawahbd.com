# Copy this file to worker/.dev.vars for local development. NEVER commit .dev.vars or real keys.
APP_SECRET=dev-only-secret-change-me-0123456789abcdef
SETUP_TOKEN=dev-setup-token
# enables the simulated payment gateway (ignored when ENVIRONMENT=production)
ALLOW_MOCK_PAYMENTS=true
# lets pages carry the analytics tag on this machine (only when an ID is set in Admin -> Settings -> Analytics; ignored when ENVIRONMENT=production)
ANALYTICS_DEV=true

# --- optional integrations: leave commented out to keep them switched off -------------
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# BKASH_APP_KEY=
# BKASH_APP_SECRET=
# BKASH_USERNAME=
# BKASH_PASSWORD=
# RESEND_API_KEY=
# GEMINI_API_KEY=
# TURNSTILE_SECRET=
